# --- Core ---
CALLIODESMO_ENVIRONMENT=development
CALLIODESMO_DEBUG=true

# --- Docker 场景（docker compose up）---
# 容器内连接串由 docker-compose.yml 的 environment 覆盖为服务名（postgres/neo4j），
# 下面 DATABASE_URL / NEO4J_URI 在容器模式下被忽略（仅本地 uv run 时生效）。
# 容器要访问宿主机的本地 LLM（Ollama/LM Studio/llama.cpp），把下面的 localhost 改为：
#   host.docker.internal（docker-compose.yml 已配 host-gateway）
# 例：CALLIODESMO_LLM_API_BASE=http://host.docker.internal:1234/v1
# --- Database (PostgreSQL 16+ + pgvector) ---
CALLIODESMO_DATABASE_URL=postgresql+asyncpg://calliodesmo:calliodesmo@localhost:5432/calliodesmo

# --- Store 后端选择（P4.5）---
# memory（零依赖，离线/旧测试兼容）| postgres / neo4j（真后端，生产与回归用）
CALLIODESMO_VECTOR_STORE_BACKEND=memory
CALLIODESMO_GRAPH_STORE_BACKEND=memory
CALLIODESMO_COMMUNITY_STORE_BACKEND=memory

# --- Neo4j (semantic layer graph store) ---
CALLIODESMO_NEO4J_URI=bolt://localhost:7687
CALLIODESMO_NEO4J_USER=neo4j
CALLIODESMO_NEO4J_PASSWORD=calliodesmo

# --- Auth / JWT ---
CALLIODESMO_JWT_SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
CALLIODESMO_JWT_ALGORITHM=HS256
CALLIODESMO_JWT_EXPIRE_MINUTES=60

# --- LLM (LiteLLM unified interface) ---
# 模型格式：<provider>/<model>，经 LiteLLM 统一接入。
# 切换后端只改这三行，代码不动。
CALLIODESMO_LLM_MODEL=openai/gpt-4o-mini
CALLIODESMO_LLM_API_KEY=
CALLIODESMO_LLM_API_BASE=
# 对 reasoning 模型禁用思考链（chat_template_kwargs.enable_thinking=False）
CALLIODESMO_LLM_DISABLE_THINKING=true

# --- LLM 后端示例（任选其一，取消注释即可） ---

# 1) OpenAI 官方
# CALLIODESMO_LLM_MODEL=openai/gpt-4o-mini
# CALLIODESMO_LLM_API_KEY=sk-...
# CALLIODESMO_LLM_API_BASE=

# 2) DeepSeek
# CALLIODESMO_LLM_MODEL=deepseek/deepseek-chat
# CALLIODESMO_LLM_API_KEY=sk-...
# CALLIODESMO_LLM_API_BASE=

# 3) 通义千问 (Qwen) DashScope
# CALLIODESMO_LLM_MODEL=openai/qwen-plus        # Qwen 兼容 OpenAI 接口
# CALLIODESMO_LLM_API_KEY=sk-...
# CALLIODESMO_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 4) Ollama（本地，无需 key）
# CALLIODESMO_LLM_MODEL=ollama/qwen2.5
# CALLIODESMO_LLM_API_KEY=
# CALLIODESMO_LLM_API_BASE=http://localhost:11434

# 5) LM Studio（本地，OpenAI 兼容，无需 key）
#    先在 LM Studio 加载模型并启动 Local Server（默认 :1234）。
# CALLIODESMO_LLM_MODEL=openai/local-model       # 模型名可任意，LM Studio 忽略
# CALLIODESMO_LLM_API_KEY=lm-studio               # 任意非空占位（本地不校验）
# CALLIODESMO_LLM_API_BASE=http://localhost:1234/v1

# 6) llama.cpp server（本地，OpenAI 兼容，无需 key）
#    启动：./llama-server -m model.gguf --port 8080
# CALLIODESMO_LLM_MODEL=openai/local-model
# CALLIODESMO_LLM_API_KEY=llama-cpp               # 任意非空占位
# CALLIODESMO_LLM_API_BASE=http://localhost:8080/v1

# 7) llama.cpp server（局域网自建，OpenAI 兼容）
#    指向内网 OpenAI 兼容服务（如 llama-server 开 --api-key 或 nano server）；模型名可填任意占位。
# CALLIODESMO_LLM_MODEL=openai/local-model
# CALLIODESMO_LLM_API_KEY=local                   # 非 localhost 需任意非空占位
# CALLIODESMO_LLM_API_BASE=http://192.168.50.115:8888/v1

# 注：当 API_BASE 指向 localhost/127.0.0.1 时，自动豁免 API key 校验。
#     远端云服务仍需填写 API key。

# --- Embedding (BGE-M3 local) ---
CALLIODESMO_EMBEDDING_PROVIDER=bge-m3
CALLIODESMO_EMBEDDING_MODEL=BAAI/bge-m3
CALLIODESMO_EMBEDDING_DIMENSION=1024
# remote 时指向嵌入服务（如 http://host:8082/v1）；空 = 本地
CALLIODESMO_EMBEDDING_API_BASE=

# --- 实体对齐（P4.5 Task 6）三段式阈值（name+description 向量余弦相似度） ---
# >=auto_merge 自动合并；[review, auto_merge) 进人工复核；<review 新节点
CALLIODESMO_ALIGNMENT_AUTO_MERGE_THRESHOLD=0.95
CALLIODESMO_ALIGNMENT_REVIEW_THRESHOLD=0.85

# --- OCR 专职（PaddleOCR-VL 1.6，文档逐字转录） ---
# 枚举：none（默认，未启用/纯文本文档）| stub（离线桩）| paddleocr（专用引擎）
CALLIODESMO_OCR_PROVIDER=none
CALLIODESMO_OCR_MODEL=PaddleOCR-VL-1.6
CALLIODESMO_OCR_PIPELINE_VERSION=v1.6
# 识别后端：llama-cpp-server（GGUF，推荐本地）| vllm-server
CALLIODESMO_OCR_VL_BACKEND=llama-cpp-server
# PaddleOCR 编排 API 地址（llama-server / vLLM server）
#CALLIODESMO_OCR_SERVER_URL=http://127.0.0.1:8080
# true = 远端编排（本机零重型依赖）；false = 本机装 paddleocr[doc-parser]（uv sync --extra documents-ocr）
CALLIODESMO_OCR_REMOTE=false
# PaddleOCR-VL 提示词（OCR:/Table:/Formula:/Chart:/Seal:）
CALLIODESMO_OCR_PROMPT=OCR:
# 摄入图片大小上限（字节，默认 15 MiB）
CALLIODESMO_OCR_IMAGE_MAX_BYTES=15728640
# 扫描 PDF：pypdf 提取为空才触发 OCR（默认 false 纯 pypdf）
CALLIODESMO_OCR_IMAGE_PREFER_OCR=false

# --- 识图专职（qwen3-vl，语义理解描述，提问侧） ---
# 本地 Ollama（默认，localhost 自动豁免 key）；切云端：模型改 gpt-4o / qwen3-vl + 填 key/base
CALLIODESMO_VISION_MODEL=ollama/qwen3-vl:8b
CALLIODESMO_VISION_API_KEY=
CALLIODESMO_VISION_API_BASE=
CALLIODESMO_VISION_PROMPT=请描述这张图片的内容：其中的实体、关系、场景、图表信息等。
# 提问侧上传图片大小上限（字节，默认 15 MiB）
CALLIODESMO_VISION_IMAGE_MAX_BYTES=15728640

# --- P5 检索质量精化 ---
# MultiQuery 查询改写：开启后 native 路多视角子查询 -> RRF 融合（默认关）
CALLIODESMO_MULTI_QUERY_ENABLED=false

# contextual retrieval：块级摘要向量混搜（默认关；配合 CHUNK_SUMMARY_ENABLED）
CALLIODESMO_CONTEXTUAL_RETRIEVAL_ENABLED=false
# context 路向量缩放占比（0=纯 native 召回，越大越偏上下文摘要通道）
CALLIODESMO_CONTEXTUAL_CONTEXT_WEIGHT=0.5

# CRAG 检索自知（默认关；开启时来源不足自动重写重查 1 轮）
CALLIODESMO_CRAG_ENABLED=false
CALLIODESMO_CRAG_THRESHOLD=0.5

# SelfCheck 答案一致性（默认关；开启时 LLM judge 低分重答 1 轮）
CALLIODESMO_SELFCHECK_ENABLED=false
CALLIODESMO_SELFCHECK_THRESHOLD=0.5

# --- P1 ECL 管线 ---
# 团队抽取模板（软引导：模板外实体保留并打标）
CALLIODESMO_EXTRACTION_TEMPLATE_FILE=config/extraction_templates.yaml
# 切分参数：块大小与重叠（字符）
CALLIODESMO_CHUNK_SIZE=1200
CALLIODESMO_CHUNK_OVERLAP=100
# 社区检测算法：connected_components（默认零依赖）| networkx_louvain（需 uv sync --extra graph-analytics）
# | leiden（v2，未实现）
CALLIODESMO_COMMUNITY_DETECTOR=connected_components
# Louvain/Leiden 模块度分辨率（越大社区越细）与随机种子（保确定性）
CALLIODESMO_COMMUNITY_RESOLUTION=1.0
CALLIODESMO_COMMUNITY_SEED=42
# 文档社区选项 B（独立嵌入聚类，不依赖实体图）：ingest 后派生文档聚类社区
CALLIODESMO_DOC_COMMUNITY_CLUSTERING=true
# 文档嵌入相似度阈值（>= 阈值连边 -> 连通分量）
CALLIODESMO_DOC_CLUSTER_THRESHOLD=0.7

# --- Bootstrap admin (used only by `calliodesmo db seed`) ---
CALLIODESMO_ADMIN_USERNAME=admin
CALLIODESMO_ADMIN_PASSWORD=

# --- P3 Web UI ---
# 自注册默认关（开启时 clearance 上限 INTERNAL，防越权自提）
CALLIODESMO_ALLOW_SELF_REGISTER=false
# CORS 兜底（默认空=关；dev 走 Vite proxy 同源，生产收紧为实际域名）
CALLIODESMO_CORS_ORIGINS=
# serve --seed-demo 演示文档目录与 seed 产物缓存
CALLIODESMO_DEMO_DIR=data/demo
CALLIODESMO_DEMO_CACHE_FILE=data/demo/seed-cache.json

# --- P2 Retrieval & RAG ---
# 检索模式：native_rag（情景层 混合）/ local（语义层 图邻居）/ global（摘要层 社区）
CALLIODESMO_DEFAULT_SEARCH_MODE=native_rag
# 混合检索与稀疏索引开关（默认开）
CALLIODESMO_HYBRID_ENABLED=true
CALLIODESMO_SPARSE_ENABLED=true
# 交叉编码器重排（bge-reranker-v2-m3）
CALLIODESMO_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 重排后端：none（保序降级，默认）| local（需 uv sync --extra search-rerank）| remote（HTTP rerank 服务）
CALLIODESMO_RERANKER_PROVIDER=none
# remote 时指向 rerank 服务（llama.cpp llama-server --rerank -m bge-reranker-v2-m3.gguf --port 8083）
# CALLIODESMO_RERANKER_PROVIDER=remote
# CALLIODESMO_RERANKER_API_BASE=http://rerank-host:8083
# CALLIODESMO_RERANKER_API_KEY=
CALLIODESMO_RERANK_TOP_N=20
# Local 模式图邻居 K 跳 / Global 模式社区召回数
CALLIODESMO_LOCAL_SEARCH_HOPS=1
CALLIODESMO_GLOBAL_TOP_COMMUNITIES=10
# L0 chunk 短摘要按需补生（默认关，开启时 ingest 每块生成 ~100 token 摘要）
CALLIODESMO_CHUNK_SUMMARY_ENABLED=false
# 评估 harness golden Q&A 集路径
CALLIODESMO_EVAL_GOLDEN_FILE=config/golden_qa.yaml

# --- P6 LLM 分析任务 ---
# 分析专用模型（质量优先选型见 docs/model-selection.md）；空 = 回退 CALLIODESMO_LLM_MODEL
CALLIODESMO_ANALYSIS_MODEL=
# 材料块数截断上限（与 ANALYSIS_MAX_INPUT_CHARS 双闸截断）
CALLIODESMO_ANALYSIS_MAX_CHUNKS=40
# 材料文本总字符预算（结构化输出 token 约 2-3x 的成本闸）
CALLIODESMO_ANALYSIS_MAX_INPUT_CHARS=24000
# 解析 / 校验回喂重试预算（可降 0 退化单次解析）
CALLIODESMO_ANALYSIS_PARSE_RETRIES=2
# 自定义分析 schema 序列化字节上限
CALLIODESMO_ANALYSIS_CUSTOM_SCHEMA_MAX_BYTES=4096
# 分析采样温度
CALLIODESMO_ANALYSIS_TEMPERATURE=0.2
# 分析 golden 集路径
CALLIODESMO_EVAL_ANALYSIS_GOLDEN_FILE=config/golden_analysis.yaml
# --- P7 Agent 模式（T10：三重预算帽 + 历史窗口 + golden 路径）---
# Agent 用模型（空 -> 回退 CALLIODESMO_LLM_MODEL）
CALLIODESMO_AGENT_MODEL=
# 单回合 ReAct 步数硬上限（超限强制收敛为部分结果+说明）
CALLIODESMO_AGENT_MAX_STEPS=6
# 单回合 token 预算（usage 逐轮累计）
CALLIODESMO_AGENT_TOKEN_BUDGET=32000
# 单回合挂钟上限（秒）
CALLIODESMO_AGENT_WALL_CLOCK_SECONDS=120
# 历史窗口保留回合数（系统提示恒留；截断 T12）
CALLIODESMO_AGENT_HISTORY_WINDOW=8
# agent golden 轨迹集路径
CALLIODESMO_EVAL_AGENT_GOLDEN_FILE=config/golden_agent.yaml
